{
  "type": "object",
  "$schema": "http://json-schema.org/draft-04/schema",
  "title": "ApprovedProductQueryDto",
  "description": "Query DTO used to search approved products using POST",
  "properties": {
    "programId": {
      "type": "string",
      "title": "Program ID"
    },
    "orderableId": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Orderable IDs"
    },
    "orderableCode": {
      "type": "string",
      "title": "Orderable Code"
    },
    "orderableName": {
      "type": "string",
      "title": "Orderable Name"
    },
    "fullSupply": {
      "type": "boolean",
      "title": "Full Supply Flag"
    },
    "active": {
      "type": "boolean",
      "title": "Active Flag"
    }
  },
  "required": ["programId"]
}
